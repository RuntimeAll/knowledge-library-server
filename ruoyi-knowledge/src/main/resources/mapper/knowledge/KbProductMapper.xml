<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN'
  'http://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace="com.ruoyi.knowledge.mapper.KbProductMapper">
    <resultMap id="result" type="com.ruoyi.knowledge.domain.KbProduct">
        <result property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="snapshotJson" column="snapshot_json"/>
        <result property="materialId" column="material_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="previousProductId" column="previous_product_id"/>
        <result property="rootProductId" column="root_product_id"/>
        <result property="versionNo" column="version_no"/>
        <result property="rowVersion" column="row_version"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <select id="selectById" resultMap="result">SELECT * FROM kb_product WHERE id=#{id}</select>
    <select id="lockById" resultMap="result">SELECT * FROM kb_product WHERE id=#{id} FOR UPDATE</select>
    <select id="selectList" resultMap="result">
        SELECT * FROM kb_product
        <where>
            <if test="title != null and title != ''">AND title LIKE CONCAT('%', #{title}, '%')</if>
            <if test="rootProductId != null">AND root_product_id=#{rootProductId}</if>
            <if test="materialId != null">AND material_id=#{materialId}</if>
        </where>
         ORDER BY id DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO kb_product (title,snapshot_json,material_id,asset_id,previous_product_id,root_product_id,version_no,row_version,create_by,create_time,update_by,update_time,remark) VALUES (#{title},#{snapshotJson},#{materialId},#{assetId},#{previousProductId},#{rootProductId},#{versionNo},0,#{createBy},NOW(),#{createBy},NOW(),#{remark})</insert>
    <update id="update">UPDATE kb_product SET title=#{title},material_id=#{materialId},asset_id=#{assetId},previous_product_id=#{previousProductId},root_product_id=#{rootProductId},version_no=#{versionNo},row_version=row_version+1,update_by=#{updateBy},update_time=NOW(),remark=#{remark} WHERE id=#{id} AND row_version=#{rowVersion}</update>
    <delete id="deleteById">DELETE FROM kb_product WHERE id=#{id}</delete>
    <update id="initializeRoot">UPDATE kb_product SET root_product_id=id WHERE id=#{id}</update>
    <select id="nextVersion" resultType="int">
        SELECT version_no + 1 FROM kb_product
        WHERE root_product_id=#{rootId}
        ORDER BY version_no DESC LIMIT 1 FOR UPDATE
    </select>
    <select id="countNewerVersions" resultType="long">SELECT COUNT(*) FROM kb_product WHERE previous_product_id=#{id}</select>
</mapper>
