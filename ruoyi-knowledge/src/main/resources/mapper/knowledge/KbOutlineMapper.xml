<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN'
  'http://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace="com.ruoyi.knowledge.mapper.KbOutlineMapper">
    <resultMap id="result" type="com.ruoyi.knowledge.domain.KbOutline">
        <result property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="rowVersion" column="row_version"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <select id="selectById" resultMap="result">SELECT * FROM kb_outline WHERE id=#{id}</select>
    <select id="lockById" resultMap="result">SELECT * FROM kb_outline WHERE id=#{id} FOR UPDATE</select>
    <select id="selectList" resultMap="result">
        SELECT * FROM kb_outline
        <where>
            <if test="title != null and title != ''">AND title LIKE CONCAT('%', #{title}, '%')</if>
        </where>
         ORDER BY id DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO kb_outline (title,description,row_version,create_by,create_time,update_by,update_time,remark) VALUES (#{title},#{description},0,#{createBy},NOW(),#{createBy},NOW(),#{remark})</insert>
    <update id="update">UPDATE kb_outline SET title=#{title},description=#{description},row_version=row_version+1,update_by=#{updateBy},update_time=NOW(),remark=#{remark} WHERE id=#{id} AND row_version=#{rowVersion}</update>
    <delete id="deleteById">DELETE FROM kb_outline WHERE id=#{id}</delete>
    <select id="countNodes" resultType="long">SELECT COUNT(*) FROM kb_outline_node WHERE outline_id=#{id}</select>
</mapper>
